LLM_API_BASE=https://provider.example/v1
LLM_API_KEY=
LLM_MODEL=

# Answer evaluation uses Judge by default; blank JUDGE_* falls back to LLM_*.
JUDGE_API_BASE=
JUDGE_API_KEY=
JUDGE_MODEL=

# Judge always uses temperature 0, regardless of this generation setting.
TEMPERATURE=0
MAX_TOKENS=1024
TIMEOUT_SECONDS=60
MAX_RETRIES=3
CONCURRENCY=4
CACHE_DIR=results/cache

